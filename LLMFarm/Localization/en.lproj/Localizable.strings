/* Заголовок секции: формат промпта */
"promptSettings.section.format" = "Prompt Format";
/* Описание: формат промпта */
"promptSettings.section.format.desc" = "Template that combines the system prompt, chat history and your message into a single text the model sees. Use {{prompt}} as a placeholder for the user's input. Example for ChatML: <|im_start|>user\\n{{prompt}}<|im_end|>\\n<|im_start|>assistant\\n";

/* Заголовок секции: опции */
"promptSettings.section.options" = "Options";

/* Подпись: обратные промпты */
"promptSettings.reversePrompts" = "Reverse prompts:";
/* Описание: обратные промпты */
"promptSettings.reversePrompts.desc" = "Strings that tell the model to stop generating. When any of these appear in the output, generation halts. Usually a closing tag like <|im_end|> or </s>.";

/* Подпись: пропускаемые токены */
"promptSettings.skipTokens" = "Skip tokens:";
/* Описание: пропускаемые токены */
"promptSettings.skipTokens.desc" = "Tokens that should be silently dropped from the output before showing it to you. Useful for hiding service tokens like <|im_start|>.";

