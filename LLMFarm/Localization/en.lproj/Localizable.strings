/* --- RAG settings (RagSettingsView.swift) --- */

"rag.section.settings" = "RAG Settings";

"rag.chunkSize" = "Chunk Size:";
"rag.chunkSize.desc" = "Size of each text chunk (in tokens) when splitting documents for indexing. Smaller chunks give more precise matches but may lose context. Larger chunks preserve context but retrieve less relevant pieces. Typical: 256–512.";

"rag.chunkOverlap" = "Chunk Overlap:";
"rag.chunkOverlap.desc" = "How many tokens consecutive chunks share. Overlap helps preserve meaning across chunk boundaries. Typical: 20–30% of chunk size (50–150 for 256–512 chunk size).";

"rag.embeddingModel" = "Embedding Model:";
"rag.embeddingModel.desc" = "Neural network that converts text chunks into vectors for similarity search. DistilBERT is fastest, MiniLM variants are more accurate. MultiQA works best for question-answering.";

"rag.similarityMetric" = "Similarity Metric:";
"rag.similarityMetric.desc" = "How similarity between vectors is measured. Dot product is fastest and works well with normalized embeddings. Cosine is standard for text. Euclidean measures geometric distance.";

"rag.textSplitter" = "Text Splitter:";
"rag.textSplitter.desc" = "Algorithm for splitting documents into chunks. 'recursive' tries to preserve paragraph and sentence boundaries (recommended). 'character' splits strictly by character count.";

"rag.maxAnswers" = "Max RAG answers count:";
"rag.maxAnswers.desc" = "How many text chunks are retrieved from the index and inserted into the prompt for each user question. More chunks give more context but also more tokens and less focus. Typical: 3–5.";

