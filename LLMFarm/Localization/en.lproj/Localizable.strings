/* --- Sampling settings --- */

/* Режим сэмплинга: temperature */
"sampling.mode.temperature" = "temperature";
/* Режим сэмплинга: greedy */
"sampling.mode.greedy" = "greedy";
/* Режим сэмплинга: mirostat */
"sampling.mode.mirostat" = "mirostat";
/* Режим сэмплинга: mirostat_v2 */
"sampling.mode.mirostat_v2" = "mirostat_v2";

"sampling.mode" = "Sampling:";
"sampling.mode.desc" = "Sampling strategy. 'temperature' is the classic method with temperature/top_k/top_p. 'greedy' always picks the most likely token. 'mirostat' and 'mirostat_v2' adaptively control perplexity for more coherent text.";

"sampling.repeatLastN" = "Repeat last N:";
"sampling.repeatLastN.desc" = "How many recent tokens to look back at when applying the repeat penalty. 0 disables penalty, -1 means the entire context, default is 64.";

"sampling.repeatPenalty" = "Repeat Penalty:";
"sampling.repeatPenalty.desc" = "Penalty for repeating the same tokens. 1.0 = no penalty, higher values (1.1–1.3) reduce looping, too high values make the text fall apart.";

"sampling.temp" = "Temp:";
"sampling.temp.desc" = "Temperature controls randomness. Lower = more predictable and deterministic, higher = more creative and diverse. 0 = always the most likely token. Typical range: 0.2–1.5.";

"sampling.topK" = "Top_k:";
"sampling.topK.desc" = "At each step, only the top K most likely tokens are kept. Lower K = more predictable text, higher K = more variety. 0 disables the filter. Typical value: 40.";

"sampling.topP" = "Top_p:";
"sampling.topP.desc" = "Nucleus sampling: only tokens whose cumulative probability is below P are kept. 1.0 disables the filter. Typical range: 0.9–0.95.";

"sampling.tfsZ" = "Tail Free Z:";
"sampling.tfsZ.desc" = "Tail-free sampling: cuts off the tail of unlikely tokens based on the change in probability. 1.0 disables it.";

"sampling.typicalN" = "Locally Typical N:";
"sampling.typicalN.desc" = "Locally typical sampling: keeps tokens whose probability is close to the entropy of the distribution. 1.0 disables it.";

"sampling.mirostatEta" = "Mirostat_eta:";
"sampling.mirostatEta.desc" = "Mirostat learning rate. Controls how quickly the algorithm adapts. Default 0.1. Lower = smoother adaptation.";

"sampling.mirostatTau" = "Mirostat_tau:";
"sampling.mirostatTau.desc" = "Target perplexity for Mirostat. This is roughly the desired 'surprise level' of the text. Lower = more focused, higher = more diverse. Default 5.0.";

"sampling.grammar" = "Grammar sampling:";
"sampling.grammar.desc" = "Restrict output to a GBNF grammar. The model can only produce strings matching the grammar. Useful for JSON, code, lists. Select a .gbnf file or leave as default.";

"sampling.placeholder.count" = "count..";
"sampling.placeholder.size" = "size..";
"sampling.placeholder.val" = "val..";
