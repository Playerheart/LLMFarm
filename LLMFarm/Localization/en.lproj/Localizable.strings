"promptSettings.section.format" = "Prompt Format";
"promptSettings.section.format.desc" = "Template that combines the system prompt, chat history and your message into a single text the model sees. Use {{prompt}} as a placeholder for the user's input. Example for ChatML: <|im_start|>user\\n{{prompt}}<|im_end|>\\n<|im_start|>assistant\\n";

"promptSettings.section.options" = "Options";

"promptSettings.reversePrompts" = "Reverse prompts:";
