/* --- Prediction settings --- */

"prediction.threads" = "Threads:";
"prediction.threads.desc" = "Number of CPU threads used for inference. More threads can speed things up, but too many cause overhead. Recommended: the number of performance cores on your device.";
"prediction.metal" = "Metal";
"prediction.metal.desc" = "Use GPU acceleration through Apple Metal. Speeds up inference on supported devices. Disable only if you see graphical glitches or crashes.";
"prediction.clipMetal" = "ClipM";
"prediction.clipMetal.desc" = "Use Metal for the CLIP vision encoder. Only affects multimodal models that accept images.";
"prediction.flashAttn" = "FAttn";
"prediction.flashAttn.desc" = "Flash Attention — an optimized attention algorithm. Uses less memory and can be faster, especially with long contexts. May not be supported by all models.";
"prediction.mlock" = "MLock";
"prediction.mlock.desc" = "Lock the model in RAM so the system cannot swap it to disk. Keeps speed consistent but uses more memory permanently.";
"prediction.mmap" = "MMap";
"prediction.mmap.desc" = "Memory-map the model file instead of loading it fully into RAM. Saves memory and lets you load larger models, but the first run may be slower.";
"prediction.context" = "Context:";
"prediction.context.desc" = "How many tokens the model can see at once (dialogue + prompt + answer). Larger contexts let the model remember more but use much more memory.";
"prediction.batchSize" = "Batch size:";
"prediction.batchSize.desc" = "How many tokens are processed in one step during prompt evaluation. Larger batches are faster but use more memory. Usually 256–512.";
"prediction.predictCount" = "Predict count:";
"prediction.predictCount.desc" = "Maximum number of tokens the model generates in one answer. Set to 0 for no limit (until the context is full).";
