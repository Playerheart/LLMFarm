"promptSettings.parseSpecial" = "Special";
/* Описание: парсить специальные токены */
"promptSettings.parseSpecial.desc" = "Whether special tokens (like <|im_start|>, </s>) in the prompt should be interpreted as control tokens or treated as plain text. Enable for models with a chat template.";

/* Подпись: добавлять BOS */
"promptSettings.bos" = "BOS";
/* Описание: добавлять BOS */
"promptSettings.bos.desc" = "Add the Beginning-Of-Sequence token at the start of the prompt. Most modern chat models handle this automatically — enable only if the model card says so.";

