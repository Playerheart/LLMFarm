/* --- Настройки RAG (RagSettingsView.swift) --- */

"rag.section.settings" = "Настройки RAG";

"rag.chunkSize" = "Размер чанка:";
"rag.chunkSize.desc" = "Размер каждого текстового чанка (в токенах) при разбиении документов для индексации. Маленькие чанки — точнее совпадения, но теряется контекст. Большие сохраняют контекст, но находят менее релевантные куски. Обычно: 256–512.";

"rag.chunkOverlap" = "Перекрытие чанков:";
"rag.chunkOverlap.desc" = "Сколько токенов соседние чанки делят друг с другом. Перекрытие помогает сохранить смысл на границах. Обычно: 20–30% от размера чанка (50–150 при размере 256–512).";

"rag.embeddingModel" = "Модель эмбеддингов:";
"rag.embeddingModel.desc" = "Нейросеть, которая переводит текстовые чанки в векторы для поиска по сходству. DistilBERT — самый быстрый, MiniLM-варианты — точнее. MultiQA лучше всего работает для вопросов-ответов.";

"rag.similarityMetric" = "Метрика сходства:";
"rag.similarityMetric.desc" = "Как измеряется сходство между векторами. Скалярное произведение быстрое и хорошо работает с нормализованными эмбеддингами. Косинусное — стандарт для текста. Евклидово измеряет геометрическое расстояние.";

"rag.textSplitter" = "Разбиение текста:";
"rag.textSplitter.desc" = "Алгоритм разбиения документов на чанки. «recursive» старается сохранять границы абзацев и предложений (рекомендуется). «character» режет строго по количеству символов.";

"rag.maxAnswers" = "Максимум ответов RAG:";
"rag.maxAnswers.desc" = "Сколько текстовых чанков достаётся из индекса и вставляется в промпт для каждого вопроса. Больше чанков — больше контекста, но и больше токенов и меньше фокуса. Обычно: 3–5.";

