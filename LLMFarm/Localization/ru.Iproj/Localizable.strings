/* --- Параметры предсказания --- */

"prediction.threads" = "Потоки:";
"prediction.threads.desc" = "Количество потоков CPU, используемых при генерации. Больше потоков — быстрее, но слишком много — замедление из-за накладных расходов. Рекомендуется: число производительных ядер устройства.";
"prediction.metal" = "Metal";
"prediction.metal.desc" = "Использовать ускорение GPU через Apple Metal. Ускоряет генерацию на поддерживаемых устройствах. Отключайте, только если видите артефакты или падения.";
"prediction.clipMetal" = "ClipM";
"prediction.clipMetal.desc" = "Использовать Metal для CLIP-энкодера изображений. Влияет только на мультимодальные модели, принимающие картинки.";
"prediction.flashAttn" = "FAttn";
"prediction.flashAttn.desc" = "Flash Attention — оптимизированный алгоритм внимания. Использует меньше памяти и работает быстрее, особенно на длинных контекстах. Поддерживается не всеми моделями.";
"prediction.mlock" = "MLock";
"prediction.mlock.desc" = "Заблокировать модель в оперативной памяти, чтобы система не выгружала её на диск. Скорость стабильнее, но ОЗУ занята постоянно.";
"prediction.mmap" = "MMap";
"prediction.mmap.desc" = "Отобразить файл модели в память (mmap) вместо полной загрузки в ОЗУ. Экономит память и позволяет запускать крупные модели, но первый запуск может быть медленнее.";
"prediction.context" = "Контекст:";
"prediction.context.desc" = "Сколько токенов модель видит одновременно (диалог + промпт + ответ). Больше контекст — больше помнит, но сильно растёт потребление памяти.";
"prediction.batchSize" = "Размер батча:";
"prediction.batchSize.desc" = "Сколько токенов обрабатывается за один шаг при разборе промпта. Большой батч — быстрее, но требует больше памяти. Обычно 256–512.";
"prediction.predictCount" = "Токенов в ответе:";
"prediction.predictCount.desc" = "Максимум токенов, которые модель сгенерирует в одном ответе. 0 — без ограничения (до заполнения контекста).";
"prediction.placeholder.count" = "число..";
"prediction.placeholder.size" = "размер..";


/* --- Параметры сэмплинга --- */

/* Режим сэмплинга: temperature */
"sampling.mode.temperature" = "temperature";
/* Режим сэмплинга: greedy */
"sampling.mode.greedy" = "greedy";
/* Режим сэмплинга: mirostat */
"sampling.mode.mirostat" = "mirostat";
/* Режим сэмплинга: mirostat_v2 */
"sampling.mode.mirostat_v2" = "mirostat_v2";

"sampling.mode" = "Сэмплирование:";
"sampling.mode.desc" = "Стратегия сэмплинга. «temperature» — классический метод с temperature/top_k/top_p. «greedy» — всегда выбирается самый вероятный токен. «mirostat» и «mirostat_v2» — адаптивно управляют perplexity для более связного текста.";

"sampling.repeatLastN" = "Учитывать N:";
"sampling.repeatLastN.desc" = "Сколько последних токенов учитывать при применении штрафа за повторы. 0 — отключить штраф, -1 — весь контекст, по умолчанию 64.";

"sampling.repeatPenalty" = "Штраф за повторы:";
"sampling.repeatPenalty.desc" = "Штраф за повторение одних и тех же токенов. 1.0 — без штрафа, больше (1.1–1.3) уменьшает зацикливание, слишком высокие значения разрушают связность текста.";

"sampling.temp" = "Температура:";
"sampling.temp.desc" = "Температура управляет случайностью. Ниже — предсказуемее, выше — креативнее и разнообразнее. 0 — всегда самый вероятный токен. Обычный диапазон: 0.2–1.5.";

"sampling.topK" = "Top_k:";
"sampling.topK.desc" = "На каждом шаге оставляются только K самых вероятных токенов. Меньше K — предсказуемее, больше K — разнообразнее. 0 — отключить фильтр. Обычно 40.";

"sampling.topP" = "Top_p:";
"sampling.topP.desc" = "Nucleus-сэмплинг: оставляются токены, чья суммарная вероятность не превышает P. 1.0 — отключить фильтр. Обычно 0.9–0.95.";

"sampling.tfsZ" = "Tail Free Z:";
"sampling.tfsZ.desc" = "Tail-free сэмплинг: отсекает хвост маловероятных токенов по изменению вероятности. 1.0 — отключено.";

"sampling.typicalN" = "Locally Typical N:";
"sampling.typicalN.desc" = "Locally typical сэмплинг: оставляет токены, вероятность которых близка к энтропии распределения. 1.0 — отключено.";

"sampling.mirostatEta" = "Mirostat_eta:";
"sampling.mirostatEta.desc" = "Скорость обучения Mirostat. Управляет тем, как быстро алгоритм адаптируется. По умолчанию 0.1. Меньше — плавнее адаптация.";

"sampling.mirostatTau" = "Mirostat_tau:";
"sampling.mirostatTau.desc" = "Целевая perplexity для Mirostat. Примерно желаемый «уровень неожиданности» текста. Меньше — собраннее, больше — разнообразнее. По умолчанию 5.0.";

"sampling.grammar" = "Грамматика:";
"sampling.grammar.desc" = "Ограничить вывод GBNF-грамматикой. Модель сможет выдавать только строки, соответствующие грамматике. Полезно для JSON, кода, списков. Выберите .gbnf-файл или оставьте значение по умолчанию.";

"sampling.placeholder.count" = "число..";
"sampling.placeholder.size" = "размер..";
"sampling.placeholder.val" = "знач..";
